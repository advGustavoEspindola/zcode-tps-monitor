{
  "description": "zcode-tps-monitor: saudação de sessão + métricas ao vivo por turno",
  "hooks": {
    "SessionStart": [
      {
        "matcher": "startup|clear",
        "hooks": [
          {
            "type": "process",
            "command": "node",
            "args": [
              "${ZCODE_PLUGIN_ROOT}/hooks/session-start.mjs"
            ],
            "timeoutMs": 3000,
            "statusMessage": "zcode-tps-monitor: iniciando…"
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "process",
            "command": "node",
            "args": [
              "${ZCODE_PLUGIN_ROOT}/hooks/prompt-submit.mjs"
            ],
            "timeoutMs": 8000,
            "statusMessage": "zcode-tps-monitor: lendo tok/s…"
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "process",
            "command": "node",
            "args": [
              "${ZCODE_PLUGIN_ROOT}/hooks/stop.mjs"
            ],
            "timeoutMs": 8000,
            "statusMessage": "zcode-tps-monitor: tok/s deste turno…"
          }
        ]
      }
    ]
  }
}
